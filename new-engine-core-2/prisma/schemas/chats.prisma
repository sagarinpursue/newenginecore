model Chat {
  chatId String @id @default(uuid(4)) @db.Uuid

  name String @unique

  chatInstanceId String?
  chatProviderId Int?
  chatProvider   ChatProvider? @relation(fields: [chatProviderId], references: [id])

  // TODO: remove this field (warning: prepare for serious changes in API)
  instanceId String?              @db.Uuid
  instance   ChatConnectInstance? @relation(fields: [instanceId], references: [instanceId])

  // TODO: remove these fields, instead create one fields for all bot, agent, whatever (warning: prepare for serious changes in API)
  botId     String?      @db.Uuid
  bot       ChatBot?     @relation(fields: [botId], references: [chatBotId])
  aiAgentId String?      @db.Uuid
  agent     ChatAiAgent? @relation(fields: [aiAgentId], references: [aiAgentId])

  userId    String?      @db.Uuid
  user      UserProfile? @relation(fields: [userId], references: [userId])
  accountId String?      @db.Uuid
  account   Account?     @relation(fields: [accountId], references: [accountId])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  chatSession ChatSession[]

  @@map("chats")
}
