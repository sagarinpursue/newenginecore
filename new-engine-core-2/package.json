{
    "name": "new-engine-core",
    "version": "1.2.1",
    "description": "New Engine Core",
    "main": "runme.js",
    "type": "module",
    "scripts": {
        "deploy-all": "node deploy-all.js",
        "build:dev": "set -a && . ./.environment/dev/.env && cd cloudformation && bash build.sh",
        "build:stage": "set -a && . ./.environment/stage/.env && cd cloudformation && bash build.sh",
        "build:prod": "set -a && . ./.environment/prod/.env && cd cloudformation && bash build.sh",
        "lint": "eslint --fix .",
        "format": "prettier --write .",
        "postinstall": "git config core.hooksPath .git-hooks || echo 'Not in a git repo'",
        "security-scan": "node security-scan.js",
        "prepare-local-run": "cd lambda-functions && ln -s _common-layer/nodejs/node_modules node_modules"
    },
    "author": "ConfidencEway",
    "license": "ISC",
    "devDependencies": {
        "@aws-sdk/client-api-gateway": "^3.734.0",
        "@aws-sdk/client-auto-scaling": "^3.758.0",
        "@aws-sdk/client-bedrock-agent": "^3.765.0",
        "@aws-sdk/client-bedrock-agent-runtime": "^3.765.0",
        "@aws-sdk/client-cloudformation": "^3.830.0",
        "@aws-sdk/client-cloudfront": "^3.787.0",
        "@aws-sdk/client-comprehend": "^3.758.0",
        "@aws-sdk/client-connect": "^3.751.0",
        "@aws-sdk/client-connectparticipant": "^3.750.0",
        "@aws-sdk/client-ec2": "^3.767.0",
        "@aws-sdk/client-elastic-load-balancing-v2": "^3.764.0",
        "@aws-sdk/client-iam": "^3.731.1",
        "@aws-sdk/client-lambda": "^3.731.1",
        "@aws-sdk/client-lex-runtime-v2": "^3.758.0",
        "@aws-sdk/client-opensearchserverless": "^3.726.1",
        "@aws-sdk/client-rds": "^3.761.0",
        "@aws-sdk/client-s3": "^3.734.0",
        "@aws-sdk/client-scheduler": "^3.738.0",
        "@aws-sdk/client-secrets-manager": "^3.821.0",
        "@eslint/js": "^9.19.0",
        "archiver": "^7.0.1",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-security": "^3.0.1",
        "git-branch": "^2.0.1",
        "globals": "^15.14.0",
        "install": "^0.13.0",
        "lint-staged": "^15.4.3",
        "npm": "^11.0.0",
        "prettier": "^3.4.2",
        "prisma": "^6.16.1"
    },
    "lint-staged": {
        "*.{js,mjs}": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
